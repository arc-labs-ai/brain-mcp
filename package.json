{
  "name": "@brain-db/mcp",
  "version": "0.4.0",
  "description": "MCP server for the Brain memory database: memory, reasoning, typed entities, graph, schema and identity as 58 MCP tools, over stdio or Streamable HTTP. To set a machine up, use @brain-db/cli \u2014 this is the server it configures.",
  "license": "Apache-2.0",
  "author": "Niraj Georgian",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "brain-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arc-labs-ai/brain-mcp.git"
  },
  "homepage": "https://github.com/arc-labs-ai/brain-mcp#readme",
  "bugs": {
    "url": "https://github.com/arc-labs-ai/brain-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsc -p tsconfig.json --watch",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "brain",
    "memory",
    "mcp",
    "model-context-protocol",
    "ai-agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^4.21.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/express": "^4.17.23",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  }
}
