# Brain REST backend the MCP server fronts.
#   hosted     → the Arc gateway, at your deployment's URL
#   self-host  → brain-edge, e.g. http://localhost:8080
BRAIN_MCP_BACKEND_URL=http://localhost:8080

# The caller's Brain API key — STDIO ONLY.
#
# Over HTTP this is ignored: every request carries its own bearer, which is
# what lets one deployment serve many users at their own identity. There is no
# fallback to this value, on purpose. A server-held key would let a client that
# forgot its Authorization header succeed as whoever this key belongs to, and
# that failure looks exactly like success.
BRAIN_MCP_API_KEY=brain_replace_me

# --- optional ---------------------------------------------------------------
# BRAIN_MCP_PORT=3333
# BRAIN_MCP_HOST=0.0.0.0
# BRAIN_MCP_REQUEST_TIMEOUT_MS=30000

# Serve MCP over stdin/stdout instead of HTTP (same as --stdio). In this mode
# BRAIN_MCP_API_KEY above is required: the client owns the process, so there is
# no request to carry a credential.
# BRAIN_MCP_STDIO=1

# NOTE: BRAIN_MCP_NAMESPACE, BRAIN_MCP_NAMESPACE_HEADER and
# BRAIN_MCP_SCOPE_HEADER are gone. The backend resolves the namespace and space
# from the API key; the scope headers were ignored for key callers, so sending
# them only looked like isolation.
#
# BRAIN_MCP_OAUTH_* are gone too, and BRAIN_MCP_OAUTH_ENABLED is now a startup
# failure rather than a no-op. See the Identity section of the README.
