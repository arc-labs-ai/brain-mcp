# Brain REST backend the MCP server fronts.
#   hosted     → the Arc gateway, e.g. https://api.arc-labs.ai
#   self-host  → brain-edge, e.g. http://localhost:8080
BRAIN_MCP_BACKEND_URL=http://localhost:8080

# Bearer API key for the backend. For multi-customer use this must be a service
# principal permitted to act on behalf of customer scopes (may_act).
BRAIN_MCP_API_KEY=brain_replace_me

# Namespace slug every request is scoped to.
BRAIN_MCP_NAMESPACE=acme

# --- optional ---------------------------------------------------------------
# Header names (defaults match the current gateway; scope header renames to
# x-brain-space once the control-plane agent→space rename lands).
# BRAIN_MCP_NAMESPACE_HEADER=x-brain-namespace
# BRAIN_MCP_SCOPE_HEADER=x-brain-agent

# BRAIN_MCP_PORT=3333
# BRAIN_MCP_HOST=0.0.0.0
# BRAIN_MCP_REQUEST_TIMEOUT_MS=30000

# --- OAuth 2.1 (optional) ---------------------------------------------------
# When enabled, the MCP endpoint requires a bearer JWT from your authorization
# server; the token's tenant claim selects the Brain namespace.
# BRAIN_MCP_OAUTH_ENABLED=true
# BRAIN_MCP_OAUTH_ISSUER=https://auth.arc-labs.ai
# BRAIN_MCP_OAUTH_JWKS_URI=https://auth.arc-labs.ai/.well-known/jwks.json
# BRAIN_MCP_OAUTH_AUDIENCE=https://mcp.arc-labs.ai
# BRAIN_MCP_PUBLIC_URL=https://mcp.arc-labs.ai
# BRAIN_MCP_OAUTH_SCOPES=brain.read brain.write
# BRAIN_MCP_OAUTH_NAMESPACE_CLAIM=namespace
